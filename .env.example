# .env.example - Copy to .env and fill in your actual values

# --- MongoDB Configuration ---
# Used by backend, scheduler, and nlp_engine.
# In Docker Compose, 'mongo' is the service name for the MongoDB container.
MONGO_URI=mongodb://mongo:27017/facebook_data
DB_NAME=facebook_data
POSTS_COLLECTION=posts
PROFILES_COLLECTION=profiles # Used by backend
USERS_COLLECTION=users     # Used by backend

# --- FastAPI Backend Configuration ---
# Generate a strong secret key for production: openssl rand -hex 32
SECRET_KEY="YOUR_VERY_STRONG_SECRET_KEY_FOR_JWT_PLEASE_CHANGE"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Facebook Scraper (via Task Scheduler) Configuration ---
# These are critical for the scraper to log into Facebook.
FACEBOOK_EMAIL=your_facebook_email@example.com
FACEBOOK_PASSWORD=your_facebook_password

# --- Task Scheduler Configuration ---
SCHEDULE_INTERVAL_MINUTES=120 # How often the scraper runs (e.g., every 2 hours)
PROXIES_LIST="" # Optional: Comma-separated list of proxies. E.g., "http://user:pass@host1:port,http://host2:port"

# --- NLP Engine Configuration ---
# Currently only needs DB access, configured above.

# --- Frontend Configuration (Build-time via Vite) ---
# These are typically set in frontend/.env.production and frontend/.env.development
# For Docker Compose with Nginx proxy, VITE_API_BASE_URL in .env.production
# should be a relative path like /api/v1.
# Example: VITE_API_BASE_URL_PROD=/api/v1 (This is just a comment, actual value is in frontend/.env files)

# --- Docker Compose Specific Settings ---
COMPOSE_PROJECT_NAME=osint_platform
# COMPOSE_FILE=docker-compose.yml (default)
# DOCKER_BUILDKIT=1 (can enable BuildKit for faster builds)
